<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>TruthCardGame.Content.Sqlite</RootNamespace>
    <AssemblyName>Game.Content.Sqlite</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Shared source. The mapping lives under Assets/Scripts/Portable so the pinned
    Unity editor compiles the exact same files (Game.Content.Sqlite.asmdef).
    Keeping the project here and linking its sources mirrors Game.Content /
    Game.Core, and is what guarantees one CLR identity per portable type: Unity
    never imports a compiled Game.Content*.dll alongside these sources.
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Portable\Game.Content.Sqlite\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Content\Game.Content.csproj" />
    <ProjectReference Include="..\Game.Core\Game.Core.csproj" />
  </ItemGroup>

  <!--
    Schema scripts. Assets/StreamingAssets is the only location Unity can read
    raw non-source files from (verbatim, at edit time and in a build), so it is
    the single physical copy. The DotNet build embeds the same files under the
    names CoreMigrations expects. Adding a migration therefore means adding the
    .sql file in one place and registering it in CoreMigrations, so there is no
    second copy to keep in step.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\StreamingAssets\GameContentSchema\*.sql"
                      LogicalName="TruthCardGame.Content.Sqlite.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
