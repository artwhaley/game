<Window x:Class="TruthCardGame.ReferenceHost.Wpf.SessionTypePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play by Session Type"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1B1C" Foreground="#FFDDDDDD">
    <Window.Resources>
        <ResourceDictionary Source="/DarkControls.xaml"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="8,5"
                BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
            <TextBlock Text="Choose a session type" FontWeight="Bold" Foreground="#FFDDDDDD"/>
        </Border>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox Grid.Row="0" x:Name="StatusList" Style="{StaticResource DarkListBox}"
                     ItemContainerStyle="{StaticResource DarkListBoxItem}" Background="#FF212226" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Text="Type to play:" Foreground="#FFB0B0B0" Margin="0,4,0,2"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <ComboBox x:Name="TypeBox" Style="{StaticResource DarkComboBox}" Width="220" Padding="3,1"/>
                <Button Content="Start Random Session" Click="OnStart" Padding="8,2" Margin="8,0,0,0"
                        Style="{StaticResource DarkButton}"/>
                <Button Content="Cancel" Click="OnCancel" Padding="8,2" Margin="6,0,0,0"
                        Style="{StaticResource DarkButton}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
