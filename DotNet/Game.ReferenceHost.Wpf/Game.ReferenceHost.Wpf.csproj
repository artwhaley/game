<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TruthCardGame.ReferenceHost.Wpf</RootNamespace>
    <AssemblyName>Game.ReferenceHost.Wpf</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Core\Game.Core.csproj" />
    <ProjectReference Include="..\Game.Content\Game.Content.csproj" />
    <ProjectReference Include="..\Game.Content.Json\Game.Content.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" Link="TestData\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
