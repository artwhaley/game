<Window x:Class="TruthCardGame.ReferenceHost.Wpf.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User / Test Profile — TruthCardGame"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1B1C" Foreground="#FFDDDDDD">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="8,5"
                BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="User / Test Profile" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="  (persisted in UserProfile.db)" FontSize="10" Foreground="#FF808080" VerticalAlignment="Center"/>
                <Button Content="Refresh" Click="OnRefresh" Padding="8,2" Margin="14,0,0,0"
                        Style="{StaticResource DarkButton}"/>
                <TextBlock x:Name="StatusText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF9CCC65"/>
            </StackPanel>
        </Border>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Kinks" FontWeight="Bold" Foreground="#FFDDDDDD" Margin="0,0,0,2"/>
            <ListBox Grid.Row="1" x:Name="KinkList" Style="{StaticResource DarkListBox}"
                     ItemContainerStyle="{StaticResource DarkListBoxItem}" Background="#FF212226"/>
            <TextBlock Grid.Row="2" x:Name="UnconfiguredHintText" Text="" FontSize="9" Foreground="#FF808080"
                       TextWrapping="Wrap" Margin="0,3,0,4"/>
            <TextBlock Grid.Row="3" Text="Equipment (owned)" FontWeight="Bold" Foreground="#FFDDDDDD" Margin="0,6,0,2"/>
            <ListBox Grid.Row="4" x:Name="EquipmentList" Style="{StaticResource DarkListBox}"
                     ItemContainerStyle="{StaticResource DarkListBoxItem}" Background="#FF212226"/>
            <TextBlock Grid.Row="5" Text="Smart Toy capabilities (available)" FontWeight="Bold" Foreground="#FFDDDDDD" Margin="0,6,0,2"/>
            <ListBox Grid.Row="6" x:Name="CapabilityList" Style="{StaticResource DarkListBox}"
                     ItemContainerStyle="{StaticResource DarkListBoxItem}" Background="#FF212226"/>
        </Grid>
    </DockPanel>
</Window>
