<Window x:Class="TruthCardGame.ReferenceHost.Wpf.ReferencePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference Player — portable engine preview"
        Width="980" Height="640">
    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Session:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="SessionCombo" Width="220" Height="24" VerticalContentAlignment="Center"/>
            <Button x:Name="StartButton" Content="Start / Restart Session" Width="150" Height="24" Margin="12,0,0,0" Click="OnStartSession"/>
            <Button x:Name="AutoButton" Content="Auto ▶" Width="80" Height="24" Margin="8,0,0,0" Click="OnAutoToggled"
                    ToolTip="Advance automatically until the session completes"/>
            <Button x:Name="DrawNextButton" Content="Draw Next" Width="110" Height="24" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnDrawNext"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Current state" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Session:" Margin="0,2,0,0"/><TextBlock x:Name="SessionTitle" Text="—" FontWeight="SemiBold"/>
                <TextBlock Text="Phase:" Margin="0,6,0,0"/><TextBlock x:Name="PhaseTitle" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Phase progress (done / target):" Margin="0,6,0,0"/>
                <TextBlock x:Name="ProgressText" Text="—" FontFamily="Consolas" FontWeight="SemiBold"/>
                <TextBlock Text="Card:" Margin="0,6,0,0"/><TextBlock x:Name="CardTitle" Text="—"/>
                <TextBlock Text="Temperatures:" Margin="0,6,0,0"/>
                <TextBlock x:Name="TemperaturesText" Text="—" FontFamily="Consolas" TextWrapping="Wrap"/>
                <TextBlock Text="Status:" Margin="0,6,0,0"/><TextBlock x:Name="StatusText" Text="Idle" FontSize="16" FontWeight="SemiBold"/>

                <GroupBox Header="Prompt / cutscene" Margin="0,14,0,0" MinHeight="170">
                    <StackPanel x:Name="InteractionArea" Margin="6"/>
                </GroupBox>
            </StackPanel>

            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Execution log" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
