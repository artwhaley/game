<Window x:Class="TruthCardGame.ReferenceHost.Wpf.ReferencePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference Player — portable engine preview"
        Width="980" Height="640"
        Background="#FF1B1B1C" Foreground="#FFDDDDDD">
    <DockPanel Margin="8" Background="#FF1B1B1C">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Session:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FFDDDDDD"/>
            <ComboBox x:Name="SessionCombo" Width="220" Height="24" VerticalContentAlignment="Center"
                      Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>
            <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#FFBBBBBB"/>
            <TextBox x:Name="SeedBox" Text="0" Width="82" Height="24" Padding="3,1"
                     Style="{StaticResource DarkTextBox}" ToolTip="Deterministic integer seed for this run"/>
            <Button Content="Randomize" Width="76" Height="24" Margin="4,0,0,0"
                    Style="{StaticResource DarkButton}" Click="OnRandomizeSeed" ToolTip="Choose a new run seed"/>
            <Button x:Name="StartButton" Content="Start / Restart Session" Width="150" Height="24" Margin="12,0,0,0"
                    Style="{StaticResource DarkButton}" Click="OnStartSession"/>
            <Button x:Name="AutoButton" Content="Auto ▶" Width="80" Height="24" Margin="8,0,0,0"
                    Style="{StaticResource DarkButton}" Click="OnAutoToggled"
                    ToolTip="Run automatically until an authored wait or session completion"/>
            <Button x:Name="DrawNextButton" Content="Continue" Width="110" Height="24" Margin="8,0,0,0"
                    Style="{StaticResource DarkButton}" IsEnabled="False" Click="OnDrawNext"/>
            <Button x:Name="HaltButton" Content="Halt / Close" Width="100" Height="24" Margin="8,0,0,0"
                    Style="{StaticResource DarkButton}" Click="OnHalt" ToolTip="Cancel the run and close the runner"/>
        </StackPanel>

        <Grid Background="#FF1B1B1C">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Background="#FF212226" Padding="8"
                    BorderBrush="#FF3A3A3E" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Current state" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Session:" Margin="0,2,0,0" Foreground="#FFBBBBBB"/>
                    <TextBlock x:Name="SessionTitle" Text="—" FontWeight="SemiBold" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Phase:" Margin="0,6,0,0" Foreground="#FFBBBBBB"/>
                    <TextBlock x:Name="PhaseTitle" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Phase progress (done / target):" Margin="0,6,0,0" Foreground="#FFBBBBBB"/>
                    <TextBlock x:Name="ProgressText" Text="—" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Card:" Margin="0,6,0,0" Foreground="#FFBBBBBB"/>
                    <TextBlock x:Name="CardTitle" Text="—" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Body:" Margin="0,6,0,0" Foreground="#FFBBBBBB"/>
                    <ScrollViewer Height="86" VerticalScrollBarVisibility="Auto" Background="#FF1B1B1C">
                        <TextBlock x:Name="CardBodyText" Text="—" TextWrapping="Wrap" Foreground="#FFDDDDDD"/>
                    </ScrollViewer>
                    <TextBlock Text="Temperatures:" Margin="0,6,0,0" Foreground="#FFBBBBBB"/>
                    <TextBlock x:Name="TemperaturesText" Text="—" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Status:" Margin="0,6,0,0" Foreground="#FFBBBBBB"/>
                    <TextBlock x:Name="StatusText" Text="Idle" FontSize="16" FontWeight="SemiBold" Foreground="#FFDDDDDD"/>

                    <GroupBox Header="Prompt / cutscene" Margin="0,14,0,0" MinHeight="170" Style="{StaticResource DarkGroupBox}">
                        <StackPanel x:Name="InteractionArea" Margin="6" Background="Transparent"/>
                    </GroupBox>
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <Border DockPanel.Dock="Top" Background="#FF212226" BorderBrush="#FF3A3A3E" BorderThickness="1"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Execution log" FontWeight="Bold" Foreground="#FFDDDDDD"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="CopyLogButton" Content="Copy Log" Margin="12,0,0,0" Padding="6,1"
                                Style="{StaticResource DarkButton}" Click="OnCopyLog"/>
                        <Button x:Name="SaveLogButton" Content="Save Log…" Margin="4,0,0,0" Padding="6,1"
                                Style="{StaticResource DarkButton}" Click="OnSaveLog"/>
                        <Button x:Name="ClearLogButton" Content="Clear Log" Margin="4,0,0,0" Padding="6,1"
                                Style="{StaticResource DarkButton}" Click="OnClearLog"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"
                         Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListBoxItem}"/>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
