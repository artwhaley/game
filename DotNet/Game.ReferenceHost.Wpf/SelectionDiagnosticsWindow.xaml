<Window x:Class="TruthCardGame.ReferenceHost.Wpf.SelectionDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selection Diagnostics"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1B1C" Foreground="#FFDDDDDD">
    <Window.Resources>
        <ResourceDictionary Source="/DarkControls.xaml"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="8,5"
                BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="PhaseText" Text="" Foreground="#FFDDDDDD" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Happiness:" VerticalAlignment="Center" Foreground="#FFB0B0B0"/>
                    <Slider x:Name="HappinessSlider" Width="220" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock x:Name="HappinessText" Text="50" Width="28" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="(test override — not persisted)" FontSize="9" Foreground="#FF808080" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Width="140" Margin="16,0,0,0"
                             Padding="3,1" ToolTip="Filter cards by title"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" Text="" FontSize="10" Foreground="#FF9CCC65" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <ListBox x:Name="DiagnosticsList" Margin="6" Style="{StaticResource DarkListBox}"
                 ItemContainerStyle="{StaticResource DarkListBoxItem}" Background="#FF212226">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Width="160" Foreground="#FFDDDDDD" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Status}" Width="70" Foreground="#FF9CCC65"/>
                            <TextBlock Text="{Binding WeightText}" Width="56" Foreground="#FF7EB6E8"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Reasons}" FontSize="10" Foreground="#FFB0B0B0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
