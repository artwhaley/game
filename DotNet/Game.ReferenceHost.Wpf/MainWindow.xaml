<Window x:Class="TruthCardGame.ReferenceHost.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:vm="clr-namespace:TruthCardGame.ReferenceHost.Wpf"
        Title="TruthCard Game — Graph Workbench"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1B1C" Foreground="#FFDDDDDD"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <vm:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <vm:BoolToVisibleConverter x:Key="BoolToVisible" />

        <!-- Nodify owns the draggable ItemContainer, so keep its graph-space
             location and selection state synchronized with the view model. -->
        <Style x:Key="GraphItemContainerStyle" TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location"
                    Value="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Style>

        <!-- One editor for every owned ActionSequence. The picker is grouped
             by the explicit registry category and filtered by owner scope. -->
        <DataTemplate x:Key="ActionSequenceTemplate">
            <Border Background="#FF26262A" BorderBrush="#FF3A3A3E" BorderThickness="1"
                    CornerRadius="2" Margin="0,3,0,0" Padding="3" AllowDrop="True" Drop="OnActionDrop">
                <StackPanel>
                    <TextBlock Text="{Binding ScopeLabel}" FontSize="10" Foreground="#FFB0B0B0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBox Style="{StaticResource DarkTextBox}" Padding="2,0" Width="72"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search Action Types"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" Padding="2,0" Width="128" Margin="3,0,0,0"
                                  ItemsSource="{Binding ActionTypePickerView}" DisplayMemberPath="DisplayLabel"
                                  SelectedValuePath="TypeKey" SelectedValue="{Binding SelectedActionTypeKey, Mode=TwoWay}"
                                  ToolTip="Action Type (filtered by owner scope)">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FF9CCC65"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <Button Content="+ Action" Click="OnAddActionInstance" Padding="5,1" Margin="3,0,0,0"
                                Style="{StaticResource DarkButton}" ToolTip="Append the selected Action Type"/>
                        <Button Content="Focus" Click="OnFocusActionSequence" Padding="5,1" Margin="3,0,0,0"
                                Style="{StaticResource DarkButton}" ToolTip="Focus this sequence in the Action Browser"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,3,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="2" Margin="0,1,0,1" AllowDrop="True" Drop="OnActionDrop"
                                        PreviewMouseLeftButtonDown="OnActionDragStart" PreviewMouseMove="OnActionRowMouseMove">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF2B2B2F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                    <Setter Property="Background" Value="#FF45272A"/>
                                                    <Setter Property="BorderBrush" Value="#FFFF6B6B"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayLabel}" Width="78" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="#FFDDDDDD"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ComboBox Padding="2,0" Width="92" Margin="2,0,2,0"
                                                      ItemsSource="{Binding ChoiceOptions}" DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChoiceEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBox Padding="2,0" Width="92" Margin="2,0,2,0"
                                                     Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTextEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBox Padding="2,0" Width="48" Margin="2,0,2,0"
                                                     Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Numeric parameter">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNumberEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Content="↑" Click="OnMoveActionUp" Padding="2,0" Style="{StaticResource DarkButton}" ToolTip="Move earlier"/>
                                            <Button Content="↓" Click="OnMoveActionDown" Padding="2,0" Style="{StaticResource DarkButton}" ToolTip="Move later"/>
                                            <Button Content="⧉" Click="OnDuplicateActionInstance" Padding="2,0" Style="{StaticResource DarkButton}" ToolTip="Duplicate this Action Instance"/>
                                            <Button Content="×" Click="OnRemoveActionInstance" Padding="3,0" Style="{StaticResource DarkButton}" ToolTip="Delete this Action Instance"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ValidationMessage}" FontSize="9" Foreground="#FFFF8A8A"
                                                   Visibility="{Binding ValidationMessage, Converter={StaticResource NullToCollapsed}}"/>
                                        <StackPanel Visibility="{Binding IsPromptChoice, Converter={StaticResource BoolToVisible}}" Margin="8,3,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PromptChoice options" FontSize="9" Foreground="#FFB0B0B0"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="{Binding ExpandLabel}" Click="OnTogglePromptChoice" Padding="4,0" Margin="5,0,0,0"
                                                        Style="{StaticResource DarkButton}"/>
                                                <Button Content="+ Option" Click="OnAddPromptChoiceOption" Padding="4,0" Margin="4,0,0,0"
                                                        Style="{StaticResource DarkButton}" ToolTip="Add a nested option (maximum 3)"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding PromptOptions}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FF222226" BorderBrush="#FF3A3A3E" BorderThickness="1" Padding="3" Margin="0,2,0,0">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBox Style="{StaticResource DarkTextBox}" Padding="2,0" Width="100"
                                                                             Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             ToolTip="Option label"/>
                                                                    <Button Content="−" Click="OnRemovePromptChoiceOption" Padding="4,0" Margin="4,0,0,0"
                                                                            Style="{StaticResource DarkButton}" ToolTip="Delete option"/>
                                                                </StackPanel>
                                                                <ContentControl Content="{Binding ActionSequence}"
                                                                                ContentTemplate="{DynamicResource ActionSequenceTemplate}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Shared node template used by both graph editors. Input/output
             connector templates give every node its connection points. -->
        <DataTemplate x:Key="NodeTemplate">
            <Grid>
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding DataContext.NodeDoubleClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Grid.InputBindings>
                <!-- Live-debug highlight ring (ticket 19): the Core VM's current node. -->
                <Border BorderBrush="#FFFFB347" BorderThickness="3" CornerRadius="9" Margin="-7"
                        Visibility="{Binding DebugActive, Converter={StaticResource BoolToVisible}}" IsHitTestVisible="False"/>
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Inputs}"
                             Output="{Binding Outputs}">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate>
                            <nodify:NodeInput IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"/>
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate>
                            <nodify:NodeOutput Header="{Binding Title}"
                                               IsConnected="{Binding IsConnected}"
                                               Anchor="{Binding Anchor, Mode=OneWayToSource}"/>
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Margin="4,2,4,4">
                        <TextBlock Text="{Binding Subtitle}" FontFamily="Consolas" FontSize="10"
                                   TextWrapping="Wrap" MaxWidth="170" Foreground="#FFB0B0B0"/>
                        <!-- Inline VariableCheck editors (ticket 14): visible only on check nodes. -->
                        <StackPanel Visibility="{Binding Check, Converter={StaticResource NullToCollapsed}}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Style="{StaticResource DarkComboBox}" Padding="2,0" MinWidth="86"
                                          ItemsSource="{x:Static vm:VariableCheckData.Sources}"
                                          SelectedItem="{Binding Check.Source, Mode=TwoWay}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}" Padding="2,0" MinWidth="40" Margin="3,0,0,0"
                                          ItemsSource="{x:Static vm:VariableCheckData.Operators}"
                                          SelectedItem="{Binding Check.Operator, Mode=TwoWay}"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Padding="2,0" MinWidth="34" Margin="3,0,0,0"
                                         Text="{Binding Check.ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding ActionSequence}"
                                        ContentTemplate="{StaticResource ActionSequenceTemplate}"
                                        Visibility="{Binding CanEditActions, Converter={StaticResource BoolToVisible}}"/>
                        <!-- Inline decision editor (ticket 16): prompt + 1-3 option rows. -->
                        <StackPanel Visibility="{Binding DecisionScope, Converter={StaticResource NullToCollapsed}}" Margin="0,4,0,0">
                            <TextBlock Text="Prompt" FontSize="10" Foreground="#FFB0B0B0"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Padding="2,0"
                                     Text="{Binding DecisionPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ItemsControl ItemsSource="{Binding DecisionRows}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF26262A" BorderBrush="#FF3A3A3E" BorderThickness="1"
                                                CornerRadius="2" Margin="0,0,0,3" Padding="3">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Style="{StaticResource DarkTextBox}" Padding="2,0" MinWidth="70"
                                                             Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Option label"/>
                                                    <Button Content="−" Click="OnRemoveDecisionOption" Padding="3,0" Margin="3,0,0,0"
                                                            Style="{StaticResource DarkButton}" ToolTip="Remove option (min 1)"/>
                                                </StackPanel>
                                                <ContentControl Content="{Binding ActionSequence}"
                                                                ContentTemplate="{StaticResource ActionSequenceTemplate}"/>
                                             </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Option" Click="OnAddDecisionOption" Padding="6,1" Margin="0,2,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource DarkButton}"
                                    Visibility="{Binding CanAddOption, Converter={StaticResource BoolToVisible}}"
                                    ToolTip="Add an option row (max 3)"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Kind}" FontFamily="Consolas" FontSize="9"
                                   Foreground="#FF808080" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="Root" Background="#FF1B1B1C">
        <!-- Top command bar -->
        <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="8,5"
                BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Graph Workbench" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                           Foreground="#FFDDDDDD"/>
                <Button Content="Run Session" Margin="16,0,0,0" Padding="10,3" Style="{StaticResource DarkButton}"
                        Click="OnRunSession"/>
                <Button Content="Play by Type" Margin="6,0,0,0" Padding="10,3" Style="{StaticResource DarkButton}"
                        Click="OnPlayByType" ToolTip="Consumer-style start: pick a session type, then play a random eligible session"/>
                <TextBlock Text="Seed:" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#FFBBBBBB"/>
                <TextBox x:Name="RunSeedBox" Text="0" Width="78" Height="24" Padding="3,1"
                         Style="{StaticResource DarkTextBox}" ToolTip="Deterministic integer seed for session selection and playback"/>
                <Button Content="Randomize" Margin="4,0,0,0" Padding="6,2" Style="{StaticResource DarkButton}"
                        Click="OnRandomizeRunSeed" ToolTip="Choose a new run seed"/>
                <Button Content="Undo (Ctrl+Z)" Margin="6,0,0,0" Padding="10,3" Style="{StaticResource DarkButton}"
                        Command="{Binding UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Undo the last authoring edit"/>
                <Button Content="Redo (Ctrl+Y)" Margin="6,0,0,0" Padding="10,3" Style="{StaticResource DarkButton}"
                        Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Redo the undone edit"/>
                <Button x:Name="PreviewToggleButton" Content="Preview ▸" Margin="6,0,0,0" Padding="10,3"
                        Style="{StaticResource DarkButton}" Click="OnTogglePreview"
                        ToolTip="Toggle the live Core preview / graph debugger"/>
                <Button Content="Reset Layout" Margin="6,0,0,0" Padding="10,3" Style="{StaticResource DarkButton}"
                        Click="OnResetLayout"/>
                <TextBlock x:Name="StatusText" Text="Loading content…" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="#FF9CCC65"/>
            </StackPanel>
        </Border>

        <!-- Live Core preview / graph debugger (ticket 19). Collapsed until the
             toolbar toggle opens it; runs the REAL Core VM against a fresh
             SQLite snapshot with node/edge highlighting on both canvases. -->
        <Border x:Name="PreviewStrip" DockPanel.Dock="Bottom" Background="#FF1E1E20"
                BorderBrush="#FF3A3A3E" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Preview" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFDDDDDD"/>
                    <TextBlock x:Name="PreviewSessionLabel" Text="(no session)" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="#FFB0B0B0"/>
                    <TextBlock Text="Seed:" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="#FFBBBBBB"/>
                    <TextBox x:Name="PreviewSeedBox" Text="0" Width="78" Height="24" Padding="3,1"
                             Style="{StaticResource DarkTextBox}" ToolTip="Deterministic integer seed for this preview run"/>
                    <Button Content="Randomize" Click="OnRandomizePreviewSeed" Padding="6,2" Margin="4,0,0,0"
                            Style="{StaticResource DarkButton}" ToolTip="Choose a new preview seed"/>
                    <Button Content="Start ▶" Click="OnPreviewStart" Padding="8,2" Margin="14,0,0,0" Style="{StaticResource DarkButton}"/>
                    <Button Content="Continue" x:Name="PreviewDrawButton" Click="OnPreviewAdvance" Padding="8,2" Margin="4,0,0,0"
                            Style="{StaticResource DarkButton}" IsEnabled="False"/>
                    <Button Content="Restart ↺" Click="OnPreviewRestart" Padding="8,2" Margin="4,0,0,0" Style="{StaticResource DarkButton}"/>
                    <Button Content="Stop ■" Click="OnPreviewStop" Padding="8,2" Margin="4,0,0,0" Style="{StaticResource DarkButton}"/>
                    <Button x:Name="PreviewCopyLogButton" Content="Copy Log" Click="OnPreviewCopyLog" Padding="6,2" Margin="12,0,0,0" Style="{StaticResource DarkButton}"/>
                    <Button x:Name="PreviewSaveLogButton" Content="Save Log…" Click="OnPreviewSaveLog" Padding="6,2" Margin="4,0,0,0" Style="{StaticResource DarkButton}"/>
                    <Button x:Name="PreviewClearLogButton" Content="Clear Log" Click="OnPreviewClearLog" Padding="6,2" Margin="4,0,0,0" Style="{StaticResource DarkButton}"/>
                    <TextBlock x:Name="PreviewStatusText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF9CCC65"/>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="PreviewTemperaturesText" Text="" Margin="2,4,0,0" FontFamily="Consolas" FontSize="11"
                           Foreground="#FFDDDDDD" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,2,0,0">
                    <TextBlock Text="Phase:" FontWeight="Bold" Foreground="#FFB0B0B0"/>
                    <TextBlock x:Name="PreviewPhaseText" Text="—" Margin="4,0,0,0" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="  Node:" FontWeight="Bold" Margin="14,0,0,0" Foreground="#FFB0B0B0"/>
                    <TextBlock x:Name="PreviewNodeText" Text="—" Margin="4,0,0,0" FontFamily="Consolas" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="  Progress:" FontWeight="Bold" Margin="14,0,0,0" Foreground="#FFB0B0B0"/>
                    <TextBlock x:Name="PreviewProgressText" Text="—" Margin="4,0,0,0" Foreground="#FFDDDDDD"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,2,0,0">
                    <TextBlock Text="Card:" FontWeight="Bold" Foreground="#FFB0B0B0"/>
                    <TextBlock x:Name="PreviewCardText" Text="—" Margin="4,0,0,0" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="  Continuation:" FontWeight="Bold" Margin="14,0,0,0" Foreground="#FFB0B0B0"/>
                    <TextBlock x:Name="PreviewStackText" Text="depth 0" Margin="4,0,0,0" FontFamily="Consolas" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="  PhaseRun:" FontWeight="Bold" Margin="14,0,0,0" Foreground="#FFB0B0B0"/>
                    <TextBlock x:Name="PreviewPhaseRunText" Text="—" Margin="4,0,0,0" FontFamily="Consolas" Foreground="#FFDDDDDD"/>
                </StackPanel>
                <TextBlock Grid.Row="4" x:Name="PreviewErrorText" Text="" Margin="2,2,0,0" Foreground="#FFFF6B6B" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="5" x:Name="PreviewInteractionArea" Margin="0,6,0,0"/>
                <ListBox Grid.Row="6" x:Name="PreviewLogList" Height="64" Margin="0,6,0,0"
                         Background="#FF141416" Foreground="#FFC8C8C8" BorderBrush="#FF3A3A3E" FontFamily="Consolas" FontSize="10"/>
                <TextBlock Grid.Row="7" Text="Preview always runs a fresh SQLite snapshot — edits during a run do not affect it."
                           Margin="0,3,0,0" FontSize="9" Foreground="#FF808080"/>
            </Grid>
        </Border>

        <!-- Library / stacked graph workbench / Inspector. Outer ratios are
             applied in code-behind; the center splitter is row-based. -->
        <Grid x:Name="PaneGrid" Background="#FF1B1B1C">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="64*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18*" MinWidth="120"/>
            </Grid.ColumnDefinitions>

            <!-- Pane 1: Library -->
            <DockPanel Grid.Column="0" Grid.RowSpan="3" Margin="4,4,2,4" Background="#FF212226">
                <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="6,4"
                        BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
                    <TextBlock Text="Library" FontWeight="Bold" Foreground="#FFDDDDDD"/>
                </Border>
                <Grid Margin="6,4,6,4" Background="#FF212226">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Keep the mode picker outside both drawers so switching
                         to Phases never hides the control needed to switch back. -->
                    <StackPanel x:Name="LibraryModeTabs" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="2,0,2,4">
                        <Button x:Name="SessionLibraryTabButton" Content="Sessions" Click="OnShowSessionLibrary"
                                Padding="5,1" Margin="0,0,3,0" Style="{StaticResource DarkButton}"/>
                        <Button x:Name="PhaseLibraryTabButton" Content="Phases" Click="OnShowPhaseLibrary"
                                Padding="5,1" Margin="0,0,3,0" Style="{StaticResource DarkButton}"/>
                        <Button x:Name="CardsLibraryTabButton" Content="Cards" Click="OnShowCardsLibrary"
                                Padding="5,1" Margin="0,0,3,0" Style="{StaticResource DarkButton}"/>
                        <Button x:Name="CatalogsLibraryTabButton" Content="Catalogs" Click="OnShowCatalogsLibrary"
                                Padding="5,1" Margin="0,0,6,0" Style="{StaticResource DarkButton}"/>
                        <Button x:Name="ProfileTabButton" Content="Profile" Click="OnShowProfile"
                                Padding="5,1" Margin="0,0,6,0" Style="{StaticResource DarkButton}"
                                ToolTip="Open the persistent user/test profile"/>
                        <TextBlock x:Name="SessionModeText" Text="Sessions" FontWeight="Bold"
                                   Foreground="#FFBBBBBB"/>
                        <Button Content="×" Click="OnClearSessionUsageFilter" Padding="3,0" Margin="4,0,0,0"
                                Style="{StaticResource DarkButton}" ToolTip="Clear Uses Phase filter"/>
                    </StackPanel>
                    <DockPanel x:Name="SessionLibraryPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,3,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Click="OnNewSession" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Create a new empty session"/>
                                <Button Content="Delete" Click="OnDeleteSession" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Delete the selected session (cascades its graph)"/>
                                <Button Content="Copy" Click="OnCopySession" Padding="6,1"
                                        Style="{StaticResource DarkButton}" ToolTip="Deep-clone the selected session (new ids; Phase references stay shared)"/>
                            </StackPanel>
                            <TextBox x:Name="SessionFilter" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"
                                     Padding="3,1" TextChanged="OnSessionFilterChanged" ToolTip="Filter sessions by title"/>
                        </StackPanel>
                        <ListBox x:Name="SessionList" Style="{StaticResource DarkListBox}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                 SelectionChanged="OnSessionListChanged"/>
                    </DockPanel>
                    <DockPanel x:Name="PhaseLibraryPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="3,0,0,0" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="Phases" FontWeight="Bold" Margin="2,0,2,4"
                                   Foreground="#FFBBBBBB"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Click="OnNewPhase" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Create a new empty phase"/>
                                <Button Content="Delete" Click="OnDeletePhase" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Delete the selected phase (blocked while referenced)"/>
                                <Button Content="Duplicate" Click="OnDuplicatePhase" Padding="6,1"
                                        Style="{StaticResource DarkButton}" ToolTip="Deep-clone the selected phase (new ids; Resources stay shared)"/>
                            </StackPanel>
                            <TextBox x:Name="PhaseFilter" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"
                                     Padding="3,1" TextChanged="OnPhaseFilterChanged" ToolTip="Filter phases by title"/>
                        </StackPanel>
                        <ListBox x:Name="PhaseList" Style="{StaticResource DarkListBox}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                 SelectionChanged="OnPhaseListChanged"
                                 PreviewMouseMove="OnPhaseListMouseMove"/>
                    </DockPanel>
                    <DockPanel x:Name="CardsLibraryPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="3,0,0,0" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="Cards" FontWeight="Bold" Margin="2,0,2,4"
                                   Foreground="#FFBBBBBB"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Click="OnNewCard" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Create a new card (defaults: WaitForContinue + Progress +10)"/>
                                <Button Content="Delete" Click="OnDeleteCard" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Delete the selected card (only card-owned data)"/>
                                <Button Content="Duplicate" Click="OnDuplicateCard" Padding="6,1"
                                        Style="{StaticResource DarkButton}" ToolTip="Deep-clone the selected card (new ids; Resources stay shared)"/>
                            </StackPanel>
                            <TextBox x:Name="CardFilter" Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"
                                     Padding="3,1" TextChanged="OnCardFilterChanged" ToolTip="Filter cards by title"/>
                        </StackPanel>
                        <ListBox x:Name="CardList" Style="{StaticResource DarkListBox}"
                                 ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                 SelectionChanged="OnCardListChanged"/>
                    </DockPanel>
                    <DockPanel x:Name="CatalogsLibraryPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="3,0,0,0" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="Catalogs" FontWeight="Bold" Margin="2,0,2,4"
                                   Foreground="#FFBBBBBB"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <TextBox x:Name="CatalogSearchBox" Style="{StaticResource DarkTextBox}" Padding="3,1"
                                     TextChanged="OnCatalogSearchChanged" ToolTip="Search catalog titles, categories, descriptions, or stable IDs"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Click="OnNewCatalogEntry" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Create a definition of the selected kind"/>
                                <Button Content="Delete" Click="OnDeleteCatalogEntry" Padding="6,1" Margin="0,0,3,0"
                                        Style="{StaticResource DarkButton}" ToolTip="Delete the selected definition (blocked while referenced)"/>
                            </StackPanel>
                            <TextBlock x:Name="CatalogUsageText" Text="" FontSize="10" Foreground="#FF9CCC65"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <DockPanel>
                            <ListBox x:Name="CatalogKindList" DockPanel.Dock="Left" Width="104"
                                     Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     SelectionChanged="OnCatalogKindChanged"/>
                            <ListBox x:Name="CatalogEntryList" Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     SelectionChanged="OnCatalogEntryChanged"/>
                        </DockPanel>
                        <StackPanel x:Name="CatalogEditorPanel" DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="Catalog entry" FontWeight="SemiBold" Foreground="#FFDDDDDD"/>
                            <TextBox x:Name="CatalogTitleBox" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="0,3,0,0"
                                     TextChanged="OnCatalogEditorChanged" ToolTip="Stable-ID catalog title"/>
                            <TextBox x:Name="CatalogDescriptionBox" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="0,3,0,0"
                                     Height="46" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="OnCatalogEditorChanged"
                                     ToolTip="Kink description"/>
                            <TextBox x:Name="CatalogCategoryBox" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="0,3,0,0"
                                     TextChanged="OnCatalogEditorChanged" ToolTip="Equipment or Smart Toy category"/>
                            <vm:RelationPickerControl x:Name="CatalogCapabilityPicker" Margin="0,3,0,0"
                                                      SelectionChanged="OnCatalogEditorChanged"
                                                      ToolTip="Required Smart Toy capabilities for a Session Type"/>
                            <Button Content="Save entry" Click="OnSaveCatalogEntry" Padding="6,1" Margin="0,4,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#FF505050" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnSplitterDragCompleted"/>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="#FF505050" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnSplitterDragCompleted"/>

            <!-- Pane 2: Session Graph -->
            <DockPanel Grid.Column="2" Grid.Row="0" Margin="2,4,2,2" Background="#FF212226">
                <Border DockPanel.Dock="Left" Width="150" Background="#FF2B2B2B" Padding="6,4"
                        BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <TextBlock x:Name="SessionHeader" Text="Session Graph" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="#FFDDDDDD"/>
                        <WrapPanel Margin="8,4,0,0">
                            <Button Content="+ Phase" Click="OnAddPhaseReference" Padding="6,1" Margin="0,0,3,0"
                                    Style="{StaticResource DarkButton}" ToolTip="Add a PhaseReference for the phase selected in the Library"/>
                            <Button Content="+ Decision" Click="OnAddSessionDecision" Padding="6,1" Margin="0,0,3,0"
                                    Style="{StaticResource DarkButton}"/>
                            <Button Content="+ End" Click="OnAddSessionEnd" Padding="6,1" Margin="0,0,3,0"
                                    Style="{StaticResource DarkButton}"/>
                            <Button Content="Delete" Click="OnDeleteSelectedNode" Padding="6,1"
                                    Style="{StaticResource DarkButton}" ToolTip="Delete the selected node"/>
                        </WrapPanel>
                    </WrapPanel>
                </Border>
                <nodify:NodifyEditor x:Name="SessionEditor"
                                     ItemsSource="{Binding SessionGraph.Nodes}"
                                     Connections="{Binding SessionGraph.Connections}"
                                     PendingConnection="{Binding SessionGraph.PendingConnection}"
                                     DisconnectConnectorCommand="{Binding SessionGraph.DisconnectConnectorCommand}"
                                     ItemTemplate="{StaticResource NodeTemplate}"
                                     ItemContainerStyle="{StaticResource GraphItemContainerStyle}"
                                     ViewportLocation="{Binding SessionGraph.ViewportLocation, Mode=TwoWay}"
                                     ViewportZoom="{Binding SessionGraph.ViewportZoom, Mode=TwoWay}"
                                     AllowDrop="True" DragOver="OnSessionDragOver" Drop="OnSessionDrop"
                                     PreviewKeyDown="OnEditorKeyDown"
                                     Background="#FF1B1B1C" Margin="2,4,2,2">
                    <nodify:NodifyEditor.ConnectionTemplate>
                        <DataTemplate>
                            <nodify:LineConnection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}">
                                <nodify:LineConnection.Style>
                                    <Style TargetType="nodify:LineConnection">
                                        <Setter Property="Stroke" Value="#FF7EB6E8"/>
                                        <Setter Property="StrokeThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DebugActive}" Value="True">
                                                <Setter Property="Stroke" Value="#FFFFB347"/>
                                                <Setter Property="StrokeThickness" Value="4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </nodify:LineConnection.Style>
                            </nodify:LineConnection>
                        </DataTemplate>
                    </nodify:NodifyEditor.ConnectionTemplate>
                    <nodify:NodifyEditor.PendingConnectionTemplate>
                        <DataTemplate>
                            <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                      CompletedCommand="{Binding CompletedCommand}"
                                                      AllowOnlyConnectors="True"/>
                        </DataTemplate>
                    </nodify:NodifyEditor.PendingConnectionTemplate>
                </nodify:NodifyEditor>
            </DockPanel>

            <GridSplitter Grid.Column="2" Grid.Row="1" Width="Auto" Height="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeDirection="Rows"
                          Background="#FF505050" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnSplitterDragCompleted"/>

            <!-- Pane 3: Phase Graph OR Card Editor (lower center; selecting a
                 Card switches to the editor, selecting a Phase returns to the graph) -->
            <DockPanel x:Name="LowerCenterPane" Grid.Column="2" Grid.Row="2" Margin="2,2,2,4" Background="#FF212226">
                <Border x:Name="PhaseGraphHeader" DockPanel.Dock="Left" Width="150" Background="#FF2B2B2B" Padding="6,4"
                        BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Phase nodes:" FontSize="10" FontWeight="Bold" Foreground="#FF9CCC65" Margin="0,0,0,2"/>
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="+ Draw" Click="OnAddCardExecutor" Padding="6,1" Margin="0,0,3,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Add a card-draw executor node"/>
                            <Button Content="+ Check" Click="OnAddVariableCheck" Padding="6,1" Margin="0,0,3,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Add a variable-check node (progress / temperature / stat branches)"/>
                            <Button Content="+ Action" Click="OnAddActionNode" Padding="6,1" Margin="0,0,3,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Add an action-sequence node"/>
                            <Button Content="+ Decision" Click="OnAddPhaseDecision" Padding="6,1" Margin="0,0,3,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Add a decision node (prompt + options)"/>
                            <Button Content="+ Return" Click="OnAddReturn" Padding="6,1" Margin="0,0,0,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Add a RETURN node (resumes the suspended caller phase)"/>
                            <Button Content="Delete" Click="OnDeleteSelectedNode" Padding="6,1" Margin="0,0,0,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Delete the selected node"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PhaseHeader" Text="Phase Graph" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="#FFDDDDDD"/>
                        </StackPanel>
                        <WrapPanel Margin="2,4,0,0">
                            <TextBlock x:Name="PhaseUsageText" Text="" FontSize="10" VerticalAlignment="Center"
                                       Foreground="#FF9CCC65"/>
                            <Button Content="Show Sessions" Click="OnShowSessions" Padding="6,1" Margin="12,0,0,0"
                                    Style="{StaticResource DarkButton}" ToolTip="List sessions referencing this phase"/>
                            <Button x:Name="MakeUniqueButton" Content="Make Unique" Click="OnMakeUnique" Padding="6,1" Margin="6,0,0,0"
                                    Style="{StaticResource DarkButton}" ToolTip="Make Unique (Ticket 17)"/>
                        </WrapPanel>
                        <!-- Exits strip (ticket 15): ordered PhaseExit list; rename always,
                             add/delete only while placement count <= 1. -->
                        <StackPanel Orientation="Horizontal" Margin="2,4,0,2">
                            <TextBlock Text="Phase Exits:" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="#FFB0B0B0"/>
                            <Button x:Name="AddExitButton" Content="+" Click="OnAddExit" Padding="4,0" Margin="4,0,0,0"
                                    Style="{StaticResource DarkButton}" ToolTip="Add Phase Exit (allowed while placement count is at most 1)"/>
                            <ItemsControl x:Name="ExitsStrip" Margin="4,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF2B2B2B" BorderBrush="#FF4A4A4E" BorderThickness="1"
                                                CornerRadius="2" Margin="0,0,4,0" Padding="4,1">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete Phase Exit" Click="OnDeleteExit"
                                                              IsEnabled="{Binding CanDelete}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBox Style="{StaticResource DarkTextBox}" Padding="2,0" MinWidth="54"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Rename exit (rename never breaks wiring; identity is the id)"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <nodify:NodifyEditor x:Name="PhaseEditor"
                                     ItemsSource="{Binding PhaseGraph.Nodes}"
                                     Connections="{Binding PhaseGraph.Connections}"
                                     PendingConnection="{Binding PhaseGraph.PendingConnection}"
                                     DisconnectConnectorCommand="{Binding PhaseGraph.DisconnectConnectorCommand}"
                                     ItemTemplate="{StaticResource NodeTemplate}"
                                     ItemContainerStyle="{StaticResource GraphItemContainerStyle}"
                                     ViewportLocation="{Binding PhaseGraph.ViewportLocation, Mode=TwoWay}"
                                     ViewportZoom="{Binding PhaseGraph.ViewportZoom, Mode=TwoWay}"
                                     PreviewKeyDown="OnEditorKeyDown"
                                     Background="#FF1B1B1C" Margin="2,4,2,2">
                    <nodify:NodifyEditor.ConnectionTemplate>
                        <DataTemplate>
                            <nodify:LineConnection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}">
                                <nodify:LineConnection.Style>
                                    <Style TargetType="nodify:LineConnection">
                                        <Setter Property="Stroke" Value="#FF7EB6E8"/>
                                        <Setter Property="StrokeThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DebugActive}" Value="True">
                                                <Setter Property="Stroke" Value="#FFFFB347"/>
                                                <Setter Property="StrokeThickness" Value="4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </nodify:LineConnection.Style>
                            </nodify:LineConnection>
                        </DataTemplate>
                    </nodify:NodifyEditor.ConnectionTemplate>
                    <nodify:NodifyEditor.PendingConnectionTemplate>
                        <DataTemplate>
                            <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                      CompletedCommand="{Binding CompletedCommand}"
                                                      AllowOnlyConnectors="True"/>
                        </DataTemplate>
                    </nodify:NodifyEditor.PendingConnectionTemplate>
                </nodify:NodifyEditor>
            </DockPanel>

            <!-- Pane 4: Inspector -->
            <DockPanel Grid.Column="4" Grid.RowSpan="3" Margin="2,4,4,4" Background="#FF212226">
                <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="6,4"
                        BorderBrush="#FF3A3A3E" BorderThickness="0,0,0,1">
                    <TextBlock Text="Inspector" FontWeight="Bold" Foreground="#FFDDDDDD"/>
                </Border>
                <Border DockPanel.Dock="Bottom" x:Name="ActionBrowserPanel" Height="250" Background="#FF1F1F22"
                        BorderBrush="#FF3A3A3E" BorderThickness="0,1,0,0" Padding="6,5">
                    <StackPanel>
                        <TextBlock Text="Action Browser" FontWeight="SemiBold" Foreground="#FFDDDDDD"/>
                        <TextBlock x:Name="ActionBrowserTargetText" Text="No focused sequence" FontSize="9"
                                   Foreground="#FFB0B0B0" Margin="0,2,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="ActionBrowserSearchBox" Style="{StaticResource DarkTextBox}" Padding="3,1"
                                 TextChanged="OnActionBrowserSearchChanged" ToolTip="Search actions by category, label, or keyword"/>
                        <ListBox x:Name="ActionBrowserList" Height="180" Margin="0,4,0,0"
                                 Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                 DisplayMemberPath="BrowserDisplayLabel" MouseLeftButtonDown="OnActionDragStart"
                                 MouseDoubleClick="OnActionBrowserDoubleClick"
                                 PreviewMouseMove="OnActionBrowserMouseMove"/>
                        <TextBlock Text="Double-click or drag an action into a sequence. Scope-invalid drops are rejected."
                                   TextWrapping="Wrap" FontSize="9" Foreground="#FF808080" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <!-- ScrollViewer: the card editor stacks a lot vertically; the
                     pane itself keeps its width under user splitter control. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,6,8,6" Background="Transparent">
                        <TextBlock Text="Selection" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#FFDDDDDD"/>
                        <TextBlock x:Name="InspTitle" Text="(none)" FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFDDDDDD"/>
                        <TextBlock x:Name="InspId" Text="" FontFamily="Consolas" FontSize="10" Foreground="#FFB0B0B0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="InspKind" Text="" FontFamily="Consolas" FontSize="10" Foreground="#FF808080" Margin="0,2,0,0"/>

                    <!-- Session metadata (ticket 13): shown when a Start node is selected. -->
                    <StackPanel x:Name="SessionMetaPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#FFDDDDDD"/>
                        <TextBlock Text="Title" FontSize="10" Foreground="#FFB0B0B0" Margin="0,0,0,1"/>
                        <TextBox x:Name="SessionTitleBox" Style="{StaticResource DarkTextBox}" Padding="3,1"
                                 TextChanged="OnSessionTitleChanged"/>
                        <TextBlock Text="Type" FontSize="10" Foreground="#FFB0B0B0" Margin="0,6,0,1"/>
                        <ComboBox x:Name="SessionTypeBox" Style="{StaticResource DarkComboBox}" Padding="3,1"
                                  DisplayMemberPath="Title" SelectionChanged="OnSessionTypeChanged"/>
                    </StackPanel>

                    <!-- Phase metadata (ticket 14): shown when an Entry node is selected. -->
                    <StackPanel x:Name="PhaseMetaPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Phase" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#FFDDDDDD"/>
                        <TextBlock Text="Title" FontSize="10" Foreground="#FFB0B0B0" Margin="0,0,0,1"/>
                        <TextBox x:Name="PhaseTitleBox" Style="{StaticResource DarkTextBox}" Padding="3,1"
                                 TextChanged="OnPhaseTitleChanged"/>
                        <TextBlock Text="Must have ALL card tags" FontSize="10" Foreground="#FFB0B0B0" Margin="0,6,0,1"/>
                        <vm:RelationPickerControl x:Name="PhaseAllTagPicker" SelectionChanged="OnPhaseTagsChanged"
                                                  ToolTip="Card must carry every listed tag"/>
                        <TextBlock Text="Must have ANY card tags" FontSize="10" Foreground="#FFB0B0B0" Margin="0,6,0,1"/>
                        <vm:RelationPickerControl x:Name="PhaseAnyTagPicker" SelectionChanged="OnPhaseTagsChanged"
                                                  ToolTip="Card must carry at least one listed tag (empty = no restriction)"/>
                        <Button Content="Preview Eligible Cards" Click="OnPreviewEligibleCards" Padding="6,1" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource DarkButton}"
                                ToolTip="Show which cards the current query selects (diagnostics)"/>
                        <Button Content="Selection Diagnostics…" Click="OnShowSelectionDiagnostics" Padding="6,1" Margin="0,4,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource DarkButton}"
                                ToolTip="Full eligibility/weight diagnostics for this phase"/>
                    </StackPanel>

                    <!-- Session weighting (Milestone B): shown when a Start node is selected. -->
                    <StackPanel x:Name="SessionWeightingPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Card Preference Weighting" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#FFDDDDDD"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="" FontSize="10" Foreground="#FFB0B0B0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Base" FontSize="10" Foreground="#FFB0B0B0"
                                       Margin="0,0,2,2" ToolTip="Score at Happiness 0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Happiness gain" FontSize="10" Foreground="#FFB0B0B0"
                                       Margin="2,0,0,2" ToolTip="How much Happiness (0-100) adds to this score"/>

                            <!-- Love -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Love" FontSize="11" Foreground="#FF9CCC65"
                                       VerticalAlignment="Center" Margin="0,0,4,2"
                                       ToolTip="Cards whose kinks you marked Love"/>
                            <TextBox x:Name="LoveBaseBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="0,0,2,2"
                                     TextChanged="OnSessionWeightingChanged"
                                     ToolTip="Love base — the Love score at Happiness 0. Love score = base + gain × Happiness/100."/>
                            <TextBox x:Name="LoveGainBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="2,0,0,2"
                                     TextChanged="OnSessionWeightingChanged"
                                     ToolTip="Love happiness gain — how strongly Happiness boosts Love. Love score = base + gain × Happiness/100."/>

                            <!-- Like -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Like" FontSize="11" Foreground="#FF9CCC65"
                                       VerticalAlignment="Center" Margin="0,0,4,2"
                                       ToolTip="Cards whose kinks you marked Like"/>
                            <TextBox x:Name="LikeBaseBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="0,0,2,2"
                                     TextChanged="OnSessionWeightingChanged"
                                     ToolTip="Like base — the Like score at Happiness 0. Like score = base + gain × Happiness/100."/>
                            <TextBox x:Name="LikeGainBox" Grid.Row="2" Grid.Column="2" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="2,0,0,2"
                                     TextChanged="OnSessionWeightingChanged"
                                     ToolTip="Like happiness gain — how strongly Happiness boosts Like. Like score = base + gain × Happiness/100."/>

                            <!-- Torture -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Torture" FontSize="11" Foreground="#FF9CCC65"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       ToolTip="Cards whose kinks you marked Torture"/>
                            <TextBox x:Name="TortureBaseBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="0,0,2,0"
                                     TextChanged="OnSessionWeightingChanged"
                                     ToolTip="Torture base — the Torture score at Happiness 100. Torture score = base + unhappiness gain × (100 − Happiness)/100."/>
                            <TextBox x:Name="TortureUnhappinessBox" Grid.Row="3" Grid.Column="2" Style="{StaticResource DarkTextBox}" Padding="3,1" Margin="2,0,0,0"
                                     TextChanged="OnSessionWeightingChanged"
                                     ToolTip="Torture unhappiness gain — how strongly LOW Happiness boosts Torture. Torture score = base + unhappiness gain × (100 − Happiness)/100."/>
                        </Grid>
                        <TextBlock Text="Scores set each card's draw weight as Happiness changes. All values ≥ 0; default 1."
                                   FontSize="9" Foreground="#FF808080" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Card editor (Milestone B round 2): shown while a Card is
                         selected in the Cards library. Fully buffered — Save
                         Card / Revert below apply or discard ALL of it
                         (title, body, relations, and the Action sequence). -->
                    <StackPanel x:Name="CardEditorInspectorPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="CardEditorTitle" Text="Card" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#FFDDDDDD"/>
                        <TextBlock Text="Title" FontSize="10" Foreground="#FFB0B0B0" Margin="0,0,0,1"/>
                        <TextBox x:Name="CardTitleBox" Style="{StaticResource DarkTextBox}" Padding="3,1"
                                 TextChanged="OnCardBufferFieldChanged" ToolTip="Card title"/>
                        <TextBlock Text="Body" FontSize="10" Foreground="#FFB0B0B0" Margin="0,6,0,1"/>
                        <TextBox x:Name="CardBodyBox" Style="{StaticResource DarkTextBox}" Padding="3,1"
                                 Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnCardBufferFieldChanged" ToolTip="Card body text shown when played"/>

                        <TextBlock Text="Card Tags" FontSize="10" Foreground="#FF9CCC65" Margin="0,8,0,1"/>
                        <vm:RelationPickerControl x:Name="CardTagPicker" SelectionChanged="OnCardBufferRelationsChanged"
                                                  ToolTip="Card must carry these tags for phases that query them"/>
                        <TextBlock Text="Kinks" FontSize="10" Foreground="#FF9CCC65" Margin="0,6,0,1"/>
                        <vm:RelationPickerControl x:Name="CardKinkPicker" SelectionChanged="OnCardBufferRelationsChanged"
                                                  ToolTip="Kinks this card carries; user preferences gate eligibility"/>
                        <TextBlock Text="Required Equipment" FontSize="10" Foreground="#FF9CCC65" Margin="0,6,0,1"/>
                        <vm:RelationPickerControl x:Name="CardEquipmentPicker" SelectionChanged="OnCardBufferRelationsChanged"
                                                  ToolTip="Every listed item must be owned for the card to be eligible"/>
                        <TextBlock Text="Required Smart Toys" FontSize="10" Foreground="#FF9CCC65" Margin="0,6,0,1"/>
                        <vm:RelationPickerControl x:Name="CardCapabilityPicker" SelectionChanged="OnCardBufferRelationsChanged"
                                                  ToolTip="Every listed capability must be available for the card to be eligible"/>

                        <TextBlock Text="Card Actions" FontSize="10" Foreground="#FF9CCC65" Margin="0,8,0,1"/>
                        <Border Background="#FF26262A" BorderBrush="#FF3A3A3E" BorderThickness="1"
                                CornerRadius="2" Padding="3">
                            <ContentControl x:Name="CardActionSequenceHost"
                                            ContentTemplate="{StaticResource ActionSequenceTemplate}"/>
                        </Border>

                        <TextBlock x:Name="CardDirtyText" Text="" FontSize="10" Foreground="#FFFFB347" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="CardSaveButton" Content="Save Card" Click="OnCardSave" Padding="8,2" Margin="0,0,6,0"
                                    Style="{StaticResource DarkButton}" ToolTip="Apply every buffered edit (one undo step)"/>
                            <Button x:Name="CardRevertButton" Content="Revert" Click="OnCardRevert" Padding="8,2"
                                    Style="{StaticResource DarkButton}" ToolTip="Discard every buffered edit"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Hint" FontWeight="SemiBold" Margin="0,16,0,4" Foreground="#FFDDDDDD"/>
                    <TextBlock Text="Pan: right-drag · Zoom: mouse wheel
Select: left-click node · Move: drag node
Connect: drag from an output connector to an input
Delete connection: Alt+click a connected connector
Delete node: select + Delete key
Drag a Phase from the Library onto the Session canvas
to place it; double-click a Phase node to open it below
Select a Card in the Cards library to edit it here" TextWrapping="Wrap" FontSize="11" Foreground="#FFB0B0B0"/>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
