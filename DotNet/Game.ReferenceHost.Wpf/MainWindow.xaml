<Window x:Class="TruthCardGame.ReferenceHost.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game.ReferenceHost — portable engine reference player"
        Width="980" Height="640">
    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Session:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="SessionCombo" Width="220" Height="24" VerticalContentAlignment="Center"/>
            <Button x:Name="StartButton" Content="Start / Restart Session" Width="150" Height="24" Margin="12,0,0,0" Click="OnStartSession"/>
            <TextBlock Text="Length:" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <Slider x:Name="LengthSlider" Width="160" Minimum="0.5" Maximum="3.0" Value="1.0"
                    TickFrequency="0.5" IsSnapToTickEnabled="False" ValueChanged="OnLengthChanged" VerticalAlignment="Center"/>
            <TextBlock x:Name="LengthLabel" Text="1.0x" VerticalAlignment="Center" Margin="6,0,0,0" Width="40"/>
            <Button x:Name="DrawNextButton" Content="Draw Next" Width="110" Height="24" Margin="20,0,0,0"
                    IsEnabled="False" Click="OnDrawNext"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Current state" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Session:" Margin="0,2,0,0"/><TextBlock x:Name="SessionTitle" Text="—"/>
                <TextBlock Text="Phase:" Margin="0,6,0,0"/><TextBlock x:Name="PhaseTitle" Text="—"/>
                <TextBlock Text="Progress (done / target):" Margin="0,6,0,0"/>
                <TextBlock x:Name="ProgressText" Text="—"/>
                <TextBlock Text="Card:" Margin="0,6,0,0"/><TextBlock x:Name="CardTitle" Text="—"/>
                <TextBlock Text="Status:" Margin="0,6,0,0"/><TextBlock x:Name="StatusText" Text="Idle" FontSize="16" FontWeight="SemiBold"/>

                <GroupBox Header="Prompt / cutscene" Margin="0,14,0,0" MinHeight="170">
                    <StackPanel x:Name="InteractionArea" Margin="6"/>
                </GroupBox>
            </StackPanel>

            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Execution log" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
