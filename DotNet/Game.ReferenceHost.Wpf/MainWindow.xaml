<Window x:Class="TruthCardGame.ReferenceHost.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        Title="TruthCard Game — Graph Workbench"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing" SizeChanged="OnSizeChanged">
    <Window.Resources>
        <!-- Shared node template used by both graph editors. -->
        <DataTemplate x:Key="NodeTemplate">
            <nodify:Node Header="{Binding Title}">
                <StackPanel Margin="4,2,4,4">
                    <TextBlock Text="{Binding Subtitle}" FontFamily="Consolas" FontSize="10"
                               TextWrapping="Wrap" MaxWidth="150" Foreground="#FFB0B0B0"/>
                    <TextBlock Text="{Binding Kind}" FontFamily="Consolas" FontSize="9"
                               Foreground="#FF808080" Margin="0,3,0,0"/>
                </StackPanel>
            </nodify:Node>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="Root">
        <!-- Top command bar -->
        <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Graph Workbench" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Content="Run Session" Margin="16,0,0,0" Padding="10,3" Click="OnRunSession"/>
                <Button Content="Reset Layout" Margin="6,0,0,0" Padding="10,3" Click="OnResetLayout"/>
                <TextBlock x:Name="StatusText" Text="Loading content…" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="#FF9CCC65"/>
            </StackPanel>
        </Border>

        <!-- Four panes with three GridSplitters. Ratios are applied in code-behind
             so they are driven by the persisted WorkbenchLayout model. -->
        <Grid x:Name="PaneGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
            </Grid.ColumnDefinitions>

            <!-- Pane 1: Library -->
            <DockPanel Grid.Column="0" Margin="4,4,2,4">
                <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="6,4">
                    <TextBlock Text="Library" FontWeight="Bold"/>
                </Border>
                <Grid Margin="6,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SessionList" Grid.Column="0" Margin="0,0,3,0"
                             SelectionChanged="OnSessionListChanged">
                        <ListBox.Template>
                            <ControlTemplate>
                                <StackPanel>
                                    <TextBlock Text="Sessions" FontWeight="Bold" Margin="2,0,2,4"/>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                    <ListBox x:Name="PhaseList" Grid.Column="1" Margin="3,0,0,0"
                             SelectionChanged="OnPhaseListChanged">
                        <ListBox.Template>
                            <ControlTemplate>
                                <StackPanel>
                                    <TextBlock Text="Phases" FontWeight="Bold" Margin="2,0,2,4"/>
                                    <ItemsPresenter/>
                                </StackPanel>
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#FF505050" ResizeBehavior="PreviousAndNext"/>

            <!-- Pane 2: Session Graph -->
            <DockPanel Grid.Column="2" Margin="2,4,2,4">
                <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SessionHeader" Text="Session Graph" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <Button Content="+ Start" Click="OnAddSessionStart" Padding="6,1" Margin="0,0,3,0" ToolTip="Add SessionStart (singular)"/>
                            <Button Content="+ Phase" Click="OnAddPhaseReference" Padding="6,1" Margin="0,0,3,0"/>
                            <Button Content="+ Decision" Click="OnAddSessionDecision" Padding="6,1" Margin="0,0,3,0"/>
                            <Button Content="+ End" Click="OnAddSessionEnd" Padding="6,1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <nodify:NodifyEditor x:Name="SessionEditor"
                                     ItemsSource="{Binding SessionGraph.Nodes}"
                                     Connections="{Binding SessionGraph.Connections}"
                                     PendingConnection="{Binding SessionGraph.PendingConnection}"
                                     ItemTemplate="{StaticResource NodeTemplate}"
                                     Background="#FF1E1E1E" Margin="2,4,2,2"/>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="#FF505050" ResizeBehavior="PreviousAndNext"/>

            <!-- Pane 3: Phase Graph -->
            <DockPanel Grid.Column="4" Margin="2,4,2,4">
                <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PhaseHeader" Text="Phase Graph" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <Button Content="+ Entry" Click="OnAddPhaseEntry" Padding="6,1" Margin="0,0,3,0" ToolTip="Add PhaseEntry (singular)"/>
                            <Button Content="+ Draw" Click="OnAddCardExecutor" Padding="6,1" Margin="0,0,3,0"/>
                            <Button Content="+ Check" Click="OnAddVariableCheck" Padding="6,1" Margin="0,0,3,0"/>
                            <Button Content="+ Action" Click="OnAddActionNode" Padding="6,1" Margin="0,0,3,0"/>
                            <Button Content="+ Decision" Click="OnAddPhaseDecision" Padding="6,1" Margin="0,0,3,0"/>
                            <Button Content="+ Return" Click="OnAddReturn" Padding="6,1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <nodify:NodifyEditor x:Name="PhaseEditor" ItemsSource="{Binding PhaseGraph.Nodes, ElementName=Root}"
                                     Connections="{Binding PhaseGraph.Connections, ElementName=Root}"
                                     PendingConnection="{Binding PhaseGraph.PendingConnection, ElementName=Root}"
                                     ItemTemplate="{StaticResource NodeTemplate}"
                                     Background="#FF1E1E1E" Margin="2,4,2,2"/>
            </DockPanel>

            <GridSplitter Grid.Column="5" Width="4" HorizontalAlignment="Stretch"
                          Background="#FF505050" ResizeBehavior="PreviousAndNext"/>

            <!-- Pane 4: Inspector -->
            <DockPanel Grid.Column="6" Margin="2,4,4,4">
                <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="6,4">
                    <TextBlock Text="Inspector" FontWeight="Bold"/>
                </Border>
                <StackPanel Margin="8,6,8,6">
                    <TextBlock Text="Selection" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="InspTitle" Text="(none)" FontWeight="Bold"/>
                    <TextBlock x:Name="InspId" Text="" FontFamily="Consolas" FontSize="10" Foreground="#FFB0B0B0" Margin="0,2,0,0"/>
                    <TextBlock x:Name="InspKind" Text="" FontFamily="Consolas" FontSize="10" Foreground="#FF808080" Margin="0,2,0,0"/>
                    <TextBlock Text="Hint" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="Pan: right-drag or space+drag · Zoom: mouse wheel
Select: left-click node · Connect: drag from an output connector to an input
Delete connection: Alt+click a connected connector" TextWrapping="Wrap" FontSize="11" Foreground="#FFB0B0B0"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>