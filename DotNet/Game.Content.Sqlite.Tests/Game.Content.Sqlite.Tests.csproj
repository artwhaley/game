    model is on the v2 graph shape while the schema/loader/repositories are still
    pre-Ticket-03/04. These suites exercise slot-era persistence surfaces that are
    being replaced; they re-enter compilation as their replacements land:
      - AuthoringRepositoryTests / HostExtensionSafetyTests -> Ticket 04 (v2 repos) + 03 (constraint tests)
      - SnapshotRoundTripTests                              -> Ticket 04 (v2 loader)
      - EngineIntegrationTests                              -> Ticket 09 (graph VM end-to-end)
  -->
  <ItemGroup>
    <Compile Remove="AuthoringRepositoryTests.cs" />
    <Compile Remove="HostExtensionSafetyTests.cs" />
    <Compile Remove="SnapshotRoundTripTests.cs" />
    <Compile Remove="EngineIntegrationTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Content.Sqlite\Game.Content.Sqlite.csproj" />
    <ProjectReference Include="..\Game.Content\Game.Content.csproj" />
    <ProjectReference Include="..\Game.Content.Samples\Game.Content.Samples.csproj" />
    <ProjectReference Include="..\Game.Core\Game.Core.csproj" />
  </ItemGroup>

</Project>
